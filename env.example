# Fournie automatiquement par le plugin PostgreSQL de Railway (variable de référence : ${{Postgres.DATABASE_URL}})
DATABASE_URL=postgres://user:pass@localhost:5432/magicpallet

# Accès au back office (/admin) : OBLIGATOIRE
ADMIN_USER=admin
ADMIN_PASSWORD=choisissez-un-mot-de-passe-long

# Facultatif
PUBLIC_URL=https://espace.magicpallet.com   # base des liens d'invitation (sinon déduite de la requête)
NOTIFY_WEBHOOK_URL=                          # webhook Slack/Teams/Make appelé à chaque demande de contact
RETENTION_DAYS=365                           # suppression automatique des prospects inactifs
PGSSL=false                                  # mettre true uniquement avec l'URL publique de Postgres
